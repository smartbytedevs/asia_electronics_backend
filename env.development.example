# =============================================================================
# Asia Electronics — BACKEND local development environment TEMPLATE
# =============================================================================
# This is a template, not a live environment file. The app does not load it.
#
# To use it:  copy this file to `.env` in this repository root, then fill in
#             the placeholders marked `TODO`.
#
#   PowerShell:  Copy-Item env.development.example .env
#   bash:        cp env.development.example .env
#
# `.env` is git-ignored and must never be committed.
#
# LOCAL DEVELOPMENT ONLY. Production values are supplied through deployment
# environment variables (e.g. Vercel project settings), never committed.
#
# Auth values below must match the frontend exactly:
#   frontend BETTER_AUTH_URL      = http://localhost:3000
#   frontend BETTER_AUTH_BASE_PATH= /api/auth
# =============================================================================

# --- Application --------------------------------------------------------------
NODE_ENV=development
PORT=8080

# --- MongoDB (backend application data) ---------------------------------------
# TODO(developer): connection string for a DEDICATED local/development database
# that holds the backend application data (products, orders, users, inventory…).
#
# Requirements:
#   - the database name is taken from the URI path
#   - it MUST be a DIFFERENT database from the frontend Better Auth database
#     (separate DB name at minimum; a separate cluster is even safer)
#   - never point this at production data and never commit the real URI
#
# Left empty on purpose: in development the server warns and then fails at
# connect time with an explicit "MONGODB_URI is not configured" message.
MONGODB_URI=

# Optional: server-selection timeout in ms before startup fails (default 10000).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# --- Better Auth JWT verification ---------------------------------------------
# These MUST match the frontend Better Auth configuration exactly; the backend
# rejects tokens whose issuer/audience differ and verifies signatures against
# the frontend's JWKS endpoint.
#
# Optional in development (auth stays disabled until set), REQUIRED in
# production. Local values:
#   JWKS URL = {frontend BETTER_AUTH_URL}{frontend BETTER_AUTH_BASE_PATH}/jwks
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000
# Comma-separated allowlist of accepted signing algorithms.
BETTER_AUTH_ALGORITHMS=RS256
# Clock-skew tolerance in seconds.
BETTER_AUTH_CLOCK_TOLERANCE_SECONDS=30

# --- Application users --------------------------------------------------------
# Auto-create a CUSTOMER user when a verified auth identity has no User record.
# ADMIN/STAFF are NEVER auto-provisioned — create and assign those roles
# directly in the backend database.
AUTO_PROVISION_CUSTOMERS=true

# --- Cloudinary (product/media upload) ----------------------------------------
# NOT CONFIGURED for local development. Media-upload features will fail until
# real (non-production) Cloudinary credentials are supplied. Leave empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pathao courier -----------------------------------------------------------
# COURIER_PROVIDER=mock is the explicit safe development mode: deterministic
# behaviour, no network calls, no credentials required. Keep it for local dev.
# Set to `pathao` only when you have non-production sandbox credentials.
COURIER_PROVIDER=mock
# Leave empty to use the NODE_ENV-derived base URL (sandbox when not production).
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_TIMEOUT_MS=
PATHAO_WEBHOOK_SECRET=
PATHAO_DEFAULT_ITEM_WEIGHT_KG=
COURIER_AUTO_DISPATCH_ON_CONFIRM=false
# Keep false in local dev (and on serverless); reconciliation is a worker job.
COURIER_RECONCILE_ENABLED=false
COURIER_RECONCILE_INTERVAL_MS=
COURIER_RECONCILE_STALE_AFTER_MS=

# --- Email --------------------------------------------------------------------
# EMAIL_PROVIDER=mock is the explicit safe development mode: in-memory, no
# network, every message is discarded. Set to `smtp` (with the fields below)
# only when you need to inspect real emails, using a NON-production mailbox.
EMAIL_PROVIDER=mock
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TIMEOUT_MS=
# Leave empty to auto-detect implicit TLS from the port (465 → true).
EMAIL_SECURE=

# --- Notifications ------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
# Dedupe window in ms (default 3600000 = 1 hour).
NOTIFICATIONS_DEDUPE_WINDOW_MS=

# --- Admin notifications ------------------------------------------------------
# Recipient of the admin NEW ORDER email; empty disables it in development.
ADMIN_EMAIL=
# Base URL of the admin dashboard in the frontend app (this project has no
# separate admin app; the dashboard is part of the storefront frontend).
ADMIN_DASHBOARD_BASE_URL=http://localhost:3000/admin/dashboard

# --- CORS ---------------------------------------------------------------------
# Browser origins allowed to call this API. Local frontend only.
CORS_ORIGINS=http://localhost:3000

# --- Storefront (customer emails) ---------------------------------------------
# Base URL of the public storefront, used for "Track Your Order" links
# (<baseUrl>/track/<orderNumber>).
STORE_URL=http://localhost:3000
