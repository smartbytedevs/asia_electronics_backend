# Asia Electronics Backend — Environment Variables Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Real secrets belong ONLY in .env / deployment secrets (e.g. Vercel env vars).
#
# VERCEL DEPLOYMENT: Vercel injects these as project environment variables
# (Settings → Environment Variables) — do NOT create a .env in the repo. On
# Vercel, NODE_ENV is automatically 'production', so the config fail-fasts on
# missing MONGODB_URI and BETTER_AUTH_JWKS_URL, and every /api/* request is
# handled by api/index.js (see vercel.json). Keep COURIER_RECONCILE_ENABLED
# false on Vercel — serverless functions have no persistent timers; run courier
# reconciliation from a dedicated worker instead.

# --- Application ---
NODE_ENV=development
PORT=4000

# --- MongoDB Atlas ---
# REQUIRED (Phase 01+). The server refuses to start without a database URI.
# Example: mongodb+srv://<user>:<password>@<cluster>/asiaelectronics?retryWrites=true&w=majority
# Leave empty here; set it in your local `.env` only (never commit a real URI).
MONGODB_URI=

# Optional: bound server-selection timeout in ms before startup fails fast.
# Defaults to 10000.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# --- Better Auth JWT (backend verification only) ---
# These MUST match the frontend Better Auth configuration exactly (the backend
# rejects tokens whose issuer/audience differ and verifies signatures against
# the frontend's JWKS). The canonical production frontend is
# https://www.taqwactg.com (the apex https://taqwactg.com 308-redirects to it).
#
#   BETTER_AUTH_JWKS_URL = <frontend base URL>/api/auth/jwks
#   BETTER_AUTH_ISSUER   = <frontend base URL>
#   BETTER_AUTH_AUDIENCE = <frontend base URL>
#
# Production (Vercel) example:
#   BETTER_AUTH_JWKS_URL=https://www.taqwactg.com/api/auth/jwks
#   BETTER_AUTH_ISSUER=https://www.taqwactg.com
#   BETTER_AUTH_AUDIENCE=https://www.taqwactg.com
# REQUIRED in production (fail fast) and optional in dev/test. In production
# they must be https URLs that do not point at localhost.
BETTER_AUTH_JWKS_URL=
BETTER_AUTH_ISSUER=
BETTER_AUTH_AUDIENCE=
# Comma-separated allowlist of accepted signing algorithms (default RS256).
BETTER_AUTH_ALGORITHMS=RS256
# Clock-skew tolerance in seconds (default 30).
BETTER_AUTH_CLOCK_TOLERANCE_SECONDS=30

# --- Application users ---
# Auto-create a CUSTOMER application user when a verified authentication
# identity has no User record (default true). ADMIN/STAFF are never created
# from JWT claims.
AUTO_PROVISION_CUSTOMERS=true

# --- Cloudinary ---
# PENDING: used when media/upload integration is implemented.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Pathao Courier ---
# Courier integration (Phase 09, ADR-0017). The backend talks to Pathao only
# when COURIER_PROVIDER=pathao; otherwise it uses the deterministic 'mock'
# provider (development/tests — no network calls, no credentials needed).
#
# ENVIRONMENT SELECTION (see src/config/index.js):
#   NODE_ENV=production → base URL https://api-hermes.pathao.com (Hermes)
#   anything else       → base URL https://courier-api-sandbox.pathao.com
# PATHAO_BASE_URL overrides the derived base URL in ANY environment. It must
# never point at the sandbox in production: the config fails fast if it does.
#
#   * DEVELOPMENT / SANDBOX (NODE_ENV != production): any credentials may be
#     used, including Pathao's publicly published sandbox demo credentials
#     (documented in ADR-0017 — test use ONLY, NEVER in production).
#   * PRODUCTION (NODE_ENV=production): COURIER_PROVIDER=pathao requires the
#     real merchant credentials below. The config THROWS at startup if any
#     value is missing, if a sandbox demo credential is detected, or if
#     PATHAO_BASE_URL points at the sandbox.
#
# Real merchant values are supplied ONLY through deployment secrets (e.g.
# Vercel env vars) — never commit them to .env or this file. Keep the
# placeholders below exactly as they are.
COURIER_PROVIDER=mock
# Leave empty to use the NODE_ENV-derived base URL (see above). Override only
# if you intentionally target a custom Pathao API host.
PATHAO_BASE_URL=
# Real merchant API credentials from the Pathao merchant dashboard. Replace
# the placeholders with the real values in .env only (never in this file).
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Store id of the merchant store that will dispatch parcels. It MUST belong to
# the account whose PATHAO_USERNAME/PASSWORD are used above.
PATHAO_STORE_ID=
# Outbound timeout in ms (default 15000).
PATHAO_TIMEOUT_MS=
# Webhook signature secret (X-Pathao-Signature). Set to accept Pathao webhooks.
PATHAO_WEBHOOK_SECRET=
# Parcel weight in kg sent to Pathao (default 0.5, allowed range 0.5–10).
PATHAO_DEFAULT_ITEM_WEIGHT_KG=
# Dispatch immediately after an admin confirms an order (default false).
COURIER_AUTO_DISPATCH_ON_CONFIRM=false
# Periodic provider reconciliation of ACTIVE shipments (default false).
COURIER_RECONCILE_ENABLED=false
COURIER_RECONCILE_INTERVAL_MS=
COURIER_RECONCILE_STALE_AFTER_MS=

# --- Email provider ---
# Transactional customer notifications (Phase 11, ADR-0019). EMAIL_PROVIDER=mock
# is the development/test default (in-memory, no network). PRODUCTION MUST SET
# EMAIL_PROVIDER=smtp — the config now FAILS FAST in production if the provider
# is unset or mock, because mock silently discards every email while the
# notification records still read SENT (this silent outage was the subject of
# the Phase 11 deployment audit). Production with smtp also requires EMAIL_HOST,
# EMAIL_USER, EMAIL_PASSWORD, EMAIL_FROM, ADMIN_EMAIL, STORE_URL and
# ADMIN_DASHBOARD_BASE_URL — otherwise the deployment refuses to boot.
# EMAIL_PORT 465 implies implicit TLS; EMAIL_PORT 587 (default) uses STARTTLS.
#
# Gmail example (needs an App Password, NOT the account password):
#   EMAIL_PROVIDER=smtp
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=youraccount@gmail.com
#   EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
#   EMAIL_FROM=youraccount@gmail.com
EMAIL_PROVIDER=mock
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Outbound SMTP timeout in ms (default 15000).
EMAIL_TIMEOUT_MS=
# Force implicit-TLS SMTP (true/false). Leave empty to auto-detect from port.
EMAIL_SECURE=

# --- Notifications ---
# Master switch for customer notifications (default true).
NOTIFICATIONS_ENABLED=true
# Within-window dedup for identical { recipient, eventType, entityRef } emails
# (ms, default 3600000 = 1 hour).
NOTIFICATIONS_DEDUPE_WINDOW_MS=

# --- Admin notifications (email) ---
# Recipient of the admin NEW ORDER email. REQUIRED in production (the config
# fails fast without it). Empty skips the admin email in dev/test.
ADMIN_EMAIL=
# Base URL of the admin dashboard, used to build the "View Order in Admin
# Dashboard" link in the admin NEW ORDER email. REQUIRED in production (fail
# fast). The admin dashboard is part of the main frontend — there is NO separate
# admin.<domain> app. Trailing slashes are stripped. Production example:
#   ADMIN_DASHBOARD_BASE_URL=https://www.taqwactg.com/admin/dashboard
# Defaults to http://localhost:3000 (development only).
ADMIN_DASHBOARD_BASE_URL=

# --- CORS ---
# Comma-separated allowlist of browser origins that may call the API
# cross-origin (the storefront). The deployed frontend is served from the www
# origin and the apex redirects to it, so both are allowlisted (origins only —
# never paths such as /admin/dashboard). Production example:
#   CORS_ORIGINS=https://www.taqwactg.com,https://taqwactg.com
# Empty in production denies all cross-origin requests (same-origin only).
# Empty in development/test allows every origin.
CORS_ORIGINS=

# --- Storefront (customer emails) ---
# Base URL of the public customer storefront. Used to build the "Track Your
# Order" link in the customer order-confirmation email (<baseUrl>/track/<orderNumber>).
# REQUIRED in production (fail fast). Production example: STORE_URL=https://www.taqwactg.com
# Defaults to http://localhost:3000 for development.
STORE_URL=
